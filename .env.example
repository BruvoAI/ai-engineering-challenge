# Copy this file to .env and edit as needed. Defaults work with no .env at all.

# LLM_PROVIDER=ollama        # default: ollama | openai | anthropic
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# --- only needed if you switch LLM_PROVIDER away from ollama ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
